# Copy to .env and set your own credentials. Do not commit .env.
# Single-quote values containing $ to prevent Docker Compose interpolation.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

WG_CONTAINER_NAME=wg-easy
WG_INTERFACE=wg0
VPN_NAME=wg-vpn
POLL_INTERVAL=60
TIMEOUT_THRESHOLD=180
LOG_LEVEL=info
DRY_RUN=false
SENTINEL_DATA_DIR=/srv/Appdata/wg-easy-sentinel

# Optional mounted secrets. Leave the direct credential values empty when used.
# PUSHOVER_APP_TOKEN_FILE=/run/secrets/pushover_app_token
# PUSHOVER_USER_KEY_FILE=/run/secrets/pushover_user_key

# SENTINEL_DATA_DIR is mounted at /app/data inside the container.
# STATE_FILE=/app/data/.wg_easy_sentinel_state
# LOCK_FILE=/tmp/wg_monitor.lock
# DOCKER_TIMEOUT=10
# HTTP_CONNECT_TIMEOUT=5
# HTTP_TIMEOUT=15
# NOTIFICATION_BATCH_SIZE=5
